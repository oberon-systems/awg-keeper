# awg-keeper agent. Installed as /etc/awg-keeper/agent.env, mode 0600, and read
# by the systemd unit. The token is the only secret here.
#
# The package generates this file with a fresh token on first install and never
# rewrites it on upgrade.

AWG_KEEPER_TOKEN=

# The gateway address of the docker network the Panel runs on. Never 0.0.0.0,
# and never the docker0 bridge: every container on the host can reach that one.
AWG_KEEPER_BIND=127.0.0.1
AWG_KEEPER_PORT=8081

# Who may call at all. Empty means loopback only.
AWG_KEEPER_ALLOWED_SUBNETS=127.0.0.0/8

# Which interfaces this agent manages. Empty means every interface awg lists.
AWG_KEEPER_INTERFACES=awg-mgmt

# Where awg-quick reads its configuration, which is where the agent persists it.
AWG_KEEPER_AWG_BIN=awg
AWG_KEEPER_AWG_CONF_DIR=/etc/amnezia/amneziawg

# Xray. Leave as shipped on a host that runs no Xray.
AWG_KEEPER_XRAY_BIN=xray
AWG_KEEPER_XRAY_API=127.0.0.1:10085
AWG_KEEPER_XRAY_CONFIG=/usr/local/etc/xray/config.json

AWG_KEEPER_LOG_LEVEL=INFO
AWG_KEEPER_DOCS=false
