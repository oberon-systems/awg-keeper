# Builds the zipapp against the Python that Debian 13 ships. pydantic-core is a
# compiled wheel, so the ABI of the build image is the ABI of the target.
FROM debian:13-slim AS build

# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY pyproject.toml requirements.txt ./
COPY src ./src

RUN python3 -m pip install --no-cache-dir --root-user-action=ignore --break-system-packages shiv==1.0.8 \
    && python3 -m shiv \
        --console-script awg-keeper-agent \
        --python "/usr/bin/env python3" \
        --compressed \
        --output-file /awg-keeper-agent.pyz \
        --requirement requirements.txt \
        .

FROM scratch AS export
COPY --from=build /awg-keeper-agent.pyz /
