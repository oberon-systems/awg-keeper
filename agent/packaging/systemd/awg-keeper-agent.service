[Unit]
Description=awg-keeper agent
Documentation=https://github.com/oberon-systems/awg-keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=awgkeeper
Group=awgkeeper
EnvironmentFile=/etc/awg-keeper/agent.env
# An rpm upgrade of amneziawg-tools chmods the config dir and empties the ACL mask.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/tmpfiles.d/awg-keeper.conf
ExecStartPre=+/usr/libexec/awg-keeper/proxies
ExecStart=/usr/bin/awg-keeper-agent
Restart=on-failure
RestartSec=5s

# The zipapp unpacks itself once per version, and ProtectHome leaves it no home
# to unpack into.
Environment=SHIV_ROOT=/var/lib/awg-keeper/.shiv

# No capabilities: awg reaches amneziawg-go through the proxy sockets the agent's
# user owns, bound over the real ones, which are root 0700.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/etc/amnezia/amneziawg /var/lib/awg-keeper
BindPaths=/run/amneziawg-agent:/run/amneziawg
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
