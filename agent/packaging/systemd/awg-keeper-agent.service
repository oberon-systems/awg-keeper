[Unit]
Description=awg-keeper agent
Documentation=https://github.com/oberon-systems/awg-keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=awgkeeper
Group=awgkeeper
EnvironmentFile=/etc/awg-keeper/agent.env
ExecStart=/usr/bin/awg-keeper-agent
Restart=on-failure
RestartSec=5s

# The zipapp unpacks itself once per version, and ProtectHome leaves it no home
# to unpack into.
Environment=SHIV_ROOT=/var/lib/awg-keeper/.shiv

# No capabilities: awg reaches amneziawg-go through its UAPI socket, which the
# host opens to a group added with SupplementaryGroups= in a drop-in.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
ReadWritePaths=/etc/amnezia/amneziawg /var/lib/awg-keeper
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
