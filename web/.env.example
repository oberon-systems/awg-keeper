# Copy to web/.env before `docker compose up`. Everything here reaches the
# panel as an AWG_PANEL_* environment variable.
#
# `make secrets` from the repository root mints all of it and writes this
# block; add ARGS=--ask to type the admin password instead of generating one.

AWG_PANEL_SECRET_KEY=
AWG_PANEL_ADMIN_USER=admin
AWG_PANEL_ADMIN_PASSWORD_HASH=

# The token the agent was installed with, out of /etc/awg-keeper/agent.env.
AWG_PANEL_AGENT_TOKEN=

# name=http://host:port, comma separated. The gateway of the network below is
# where the agent listens.
AWG_PANEL_AGENTS=gateway=http://172.30.0.1:8081
AWG_PANEL_PROBE_INTERVAL=30
AWG_PANEL_CHECK_RETENTION=7

# Empty means every source, which is what a reverse proxy in front makes true.
AWG_PANEL_ALLOWED_SUBNETS=

AWG_PANEL_LOG_LEVEL=INFO
AWG_PANEL_DOCS=false

# Compose itself.
PANEL_SUBNET=172.30.0.0/24
PANEL_TAG=latest
